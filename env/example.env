# Örnek ortam dosyası — GERÇEK SIR YAZMAYIN. Kullanmak için elle kopyalamayın:
#   Windows:   .\scripts\mimcor.ps1 init demo        (env\demo.env dosyasını rastgele sırlarla üretir)
#   Mac/Linux: ./scripts/mimcor.sh init demo
# Üretilen env\<ortam>.env Git'e girmez (.gitignore).
COMPOSE_PROJECT_NAME=mimcor-ornek
MIMCOR_PROFILE=local-http
HTTP_PORT=8080
HTTPS_PORT=8443
DJANGO_SECRET_KEY=<kurulumda-uretilir>
POSTGRES_PASSWORD=<kurulumda-uretilir>
DEMO_USER_PASSWORD=<kurulumda-uretilir>
DJANGO_LOCAL_HTTP=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_BASE_URL=http://localhost:8080
APP_IMAGE_TAG=local
# Kaynak sınırları (isteğe bağlı)
APP_CPUS=1.5
APP_MEMORY=768m
DB_CPUS=1.0
DB_MEMORY=512m
WEB_CPUS=0.5
WEB_MEMORY=128m
