# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env dosyası git'e eklenmez.
DJANGO_SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Telefonla aynı ağdan erişim için sunucunun IP'sini ekleyin, ör. 192.168.1.20
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=mimcor
POSTGRES_USER=mimcor
POSTGRES_PASSWORD=yerel-parolaniz
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Oturum: hareketsizlik zaman aşımı (dakika) ve mutlak oturum süresi (saat)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Örnek veri yüklenirken tüm demo kullanıcılarına verilecek parola (seed_demo)
DEMO_USER_PASSWORD=
# İş emri kapanışında malzeme dengesi toleransı (yüzde)
WORK_ORDER_BALANCE_TOLERANCE_PCT=3
# QR etiket bağlantılarının tabanı (yerel ağdaki uygulama adresi). Boş bırakılırsa etiket ekranı uyarır.
APP_BASE_URL=
# Düzeltme talebini açanın kendi talebini onaylaması (1 = izin ver). Varsayılan kapalı.
CORRECTION_SELF_APPROVAL=0
# Müşteri belgeleri için yükleme klasörü (statik dosyalardan ayrı, git dışında)
# MEDIA_ROOT=/var/lib/mimcor/media
